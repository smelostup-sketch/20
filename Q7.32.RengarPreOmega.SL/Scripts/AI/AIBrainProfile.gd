extends Resource
class_name AIBrainProfile
## Профиль мозга врага (Q7.17, Фаза A): РУЧКИ СЛОЖНОСТИ — данные, не код
## (концепция ИИ заказчика §3; тот же паттерн, что CreatureProfile — единообразие).
## Уровни сложности (Новобранец/Солдат/Ветеран) = отдельные .tres с наборами
## чисел и родословной; тюнинг — Фаза B и ПОСЛЕ финальных анимаций (вердикт
## заказчика 1b от 2026-10-12: тайминги заморожены).
##
## Значения по умолчанию Фазы A подобраны так, чтобы поведение было ИДЕНТИЧНО
## legacy (преследование + случайные атаки, без блока врага): реакция 0,
## блок 0, паттерн 1 (= чистый рандом), токены 1 (дуэль 1v1).

@export_group("Ручки сложности (концепция §3)")
## Бюджет реакции врага, мс (концепция §3): задержка между ВИДИМЫМ стартом
## атаки игрока (attack_performed) и ответным решением (блок). 0 = мгновенно.
@export_range(0, 1000, 10) var reaction_ms := 0
## Отход после стана (B2, концепция §L2 «после стана — отход»): секунды
## принудительного RETREAT после окончания стана. 0.0 = legacy (без отхода).
@export_range(0.0, 5.0, 0.1) var post_stun_retreat_time := 0.0
## Вероятность блока врага (Фаза B: блок с бюджетом реакции; сейчас 0 = legacy).
@export_range(0.0, 1.0, 0.05) var block_chance := 0.0
## Вероятность угадать направление блока игрока (Фаза B).
@export_range(0.0, 1.0, 0.05) var block_dir_guess_chance := 0.0
## Множитель частоты атак (Фаза B; 1.0 = legacy).
@export_range(0.0, 2.0, 0.05) var aggression := 1.0
## Длина читаемой серии направлений (концепция §L2): 1 = чистый рандом (legacy);
## 2–3 = серии повторов с редкой сменой — игрок читает привычку врага.
@export_range(1, 4, 1) var pattern_length := 1
## Вероятность СМЕНЫ направления после исчерпания серии (концепция §L2 «серии
## 2-3 повторов с РЕДКОЙ сменой»): 1.0 = всегда новая (при length=1 — legacy-
## рандом); 0.35 = смена в 35% случаев, иначе то же направление ещё на серию.
## (0.0 = никогда не менять — край для тестов.)
@export_range(0.0, 1.0, 0.05) var pattern_switch_chance := 1.0
## Ритм дуэли (концепция §L4 в дуэльном режиме): пауза между циклами атаки, с —
## равномерный случайный интервал в [min, max] после получения исхода.
## 0.0/0.0 = legacy (бей сразу как ядро свободно). Числа Duelist-профиля —
## ПЕРВИЧНАЯ калибровка под feel-чек заказчика, не замерный факт.
@export_range(0.0, 5.0, 0.1) var attack_interval_min := 0.0
@export_range(0.0, 5.0, 0.1) var attack_interval_max := 0.0
## L4 задел под толпу (Doom-токены): сколько ударов разрешено на окно ритма.
@export_range(1, 8, 1) var tokens_per_window := 1
## Множитель длины замаха (телеграфа).
## СЛОВАРЬ РУЧКИ (фиксация по решению заказчика от 2026-10-12, п.5):
## на этапе плейсхолдерных анимаций телеграф физически масштабируется ТОЛЬКО
## целиком скоростью клипа (attack_animation_speed врага, экспорт тела);
## фазовое масштабирование (замах длиннее, свинг быстрый) возможно лишь с
## финальными анимациями. Известное нарушение контракта ≥0.5с (вердикт 1b):
## бюджет ПКМ RIGHT/UP = +0.133 с на 1.5 м (замер sim_block_timing Q7.15) —
## принято как известное до финальных анимаций. В Фазе A ручка — данные,
## потребитель появится при тюнинге (Фаза B+).
@export_range(0.5, 2.0, 0.05) var telegraph_scale := 1.0

@export_group("B3: поиск потерянного игрока (куст)")
## Главный выключатель поиска (B3): false = legacy (потерял игрока → IDLE).
## Дефолт сохраняет поведение Q7.20 до включения профилем (требование adr §4).
@export var bush_search_enabled := false
## Радиус «прибыл» к последней видимой точке (м). Родословная: legacy
## stop_distance=1.5 (экспорт AIBrainComponent) — тот же смысл «достаточно близко».
@export_range(0.25, 3.0, 0.05) var investigate_arrive_radius := 1.5
## Вероятность после прибытия занять засаду у края куста (AMBUSH_WAIT) вместо
## патруля. 0.0 = всегда патруль. Число Дуэлянта — калибровка-гипотеза под feel-чек.
@export_range(0.0, 1.0, 0.05) var ambush_chance := 0.0
## Сколько держать засаду у края куста (с), затем переход к патрулю. 0 = сразу патруль.
@export_range(0.0, 10.0, 0.1) var ambush_wait_time := 0.0
## Радиус орбиты патруля вокруг куста/последней видимой точки (м). Родословная:
## половина куста 3.0 (замер сцены: BoxShape3D size 6×6×6 / 2) + 1.0 зазор —
## враг кружит НЕ входя в куст и остаётся видимым (игрок читает угрозу).
@export_range(1.0, 10.0, 0.1) var patrol_radius := 4.0
## Полное время поиска (с): патруль до истечения → IDLE (adr §B3 «search_time
## истёк → IDLE/возврат к точке патруля»; возврат к точке — ручка на будущее).
@export_range(0.0, 30.0, 0.5) var search_time := 0.0
## Вероятность слепого удара по кусту на каждый интервал-ролл (adr §B3;
## «наугад бьёт куст» — видение заказчика 13.10.2026). 0 = не бьёт (legacy).
## Число Дуэлянта — калибровка-гипотеза под feel-чек.
@export_range(0.0, 1.0, 0.05) var blind_strike_chance := 0.0
## Интервал между роллами слепого удара (с). Родословная-якорь: реже ритма дуэли
## attack_interval 0.3–1.0 (B1) — слепой удар не должен быть «пулемётом по кусту».
@export_range(0.2, 5.0, 0.1) var blind_strike_interval := 1.5
## Дистанция до ЦЕНТРА куста, с которой слепой удар возможен (м). Родословная
## (замеры сцены): радиус куста 3.0 (BoxShape3D 6×6×6 / 2) + меч 1.2
## (BoxMesh_player_sword size.y) + полкорпуса 0.5 (BoxShape3D_xh4up size.x
## 0.996826 / 2) ≈ 4.7 → 4.5 консервативно: с орбиты патруля (4.0) клинок
## достаёт до края куста; если дальше — мозг сначала доходит до края.
@export_range(1.0, 10.0, 0.1) var blind_strike_range := 4.5
## Множитель скорости в состояниях поиска (INVESTIGATE/SEARCH). 1.0 = скорость
## CHASE (у врага speed=3.0 м/с — уже «прочёсывающий» шаг против 6.0 игрока).
@export_range(0.1, 2.0, 0.05) var search_speed_scale := 1.0

@export_group("B4: самосохранение (бегство/укрытие/охрана)")
## Главный выключатель самосохранения (B4): false = legacy (раненый враг
## дерётся до конца). Вердикты заказчика 17.10.2026: выход из укрытия — когда
## игрока нет рядом (БЕЗ таймеров: «таймеры — зло в нашей игре»); после выхода —
## охранять манекен; регенерация hp — задел будущего (при hp >= порога враг
## сам возвращается к обычным решениям).
@export var self_preservation_enabled := false
## Порог hp-доли, ниже которой враг «сильно ранен» (видение заказчика 13.10.2026).
## Число Дуэлянта — калибровка-гипотеза под feel-чек.
@export_range(0.0, 1.0, 0.05) var flee_hp_threshold := 0.3
## Порог «уверенности в победе»: триггер = hp НИЖЕ flee_hp_threshold И
## уверенность НИЖЕ этого порога (честная оценка: hp + статистика Memory —
## доля попаданий/блоков моих атак; формула — в AIBrainComponent._confidence,
## коэффициенты линеаризации — первичная гипотеза, веса ниже — ручки).
@export_range(0.0, 1.0, 0.05) var flee_confidence_threshold := 0.4
## Веса уверенности: вклад доли hp и боевого опыта Memory (0 = вклад выключен;
## дефолт 1/0 = чистый hp — минимальное поведение; Дуэлянт — гипотеза 0.6/0.4).
@export_range(0.0, 1.0, 0.05) var confidence_hp_weight := 1.0
@export_range(0.0, 1.0, 0.05) var confidence_record_weight := 0.0
## Дальность «угрозы» (м): триггер и реарм бегства, только если игрок виден и
## не дальше этого. Родословная: detection_range=8.0 (legacy EnemyController).
@export_range(0.5, 30.0, 0.5) var flee_threat_range := 8.0
## Дистанция «игрока нет рядом» для выхода из укрытия/прекращения бегства (м).
## Родословная: 1.5 × detection_range (8.0) = 12.0 — гистерезис против
## осцилляции «вышел-снова-бежит» (вход в угрозу 8.0, выход 12.0).
@export_range(1.0, 40.0, 0.5) var flee_exit_distance := 12.0
## Множитель скорости бегства. Гипотеза под feel-чек: 3.0 × 1.3 = 3.9 м/с —
## быстрее шага, но игрока (6.0) НЕ обгоняет: без куста/дистанции не спастись
## (напряжение погони сохраняется).
@export_range(0.5, 2.0, 0.05) var flee_speed_scale := 1.3
## Группа узла-поста охраны (манекен сцены). Данные сцены, не код.
@export var guard_group := "dummy_enemy"
## ПОСТ ПО УМОЛЧАНИЮ (вердикт заказчика 17.10.2026: «Он должен по умолчанию
## идти охранять манекен — патрулировать рядом (без хардкода)»): когда игрок
## потерян и поиск окончен (или не включён) — идти к посту и патрулировать
## рядом, а не стоять (прежний IDLE заказчик видел как «зависает»). false =
## legacy (IDLE). Точка поста — из данных сцены (группа guard_group).
@export var guard_post_enabled := false
## Радиус патрульной орбиты вокруг поста (м). Число Дуэлянта — калибровка-
## гипотеза под feel-чек: компактнее кустовой (4.0) — пост это точка, не зона.
@export_range(0.5, 10.0, 0.1) var guard_patrol_radius := 2.5
## ИСПУГ ОТ ЗАСАДЫ (вердикт заказчика 17.10.2026: «враг при получении урона
## из засады должен пугаться и убегать, если противник не обнаружен» — иначе
## игроку выгодно бить невидимого безответно). Урон от НЕВИДИМОГО атакующего
## → FLEE от источника удара (направление удара — честный сенсор: факт
## контакта, HealthComponent.damaged). Работает при любом hp (испуг — не
## про раны). false = legacy.
@export var fear_on_ambush_damage := false
