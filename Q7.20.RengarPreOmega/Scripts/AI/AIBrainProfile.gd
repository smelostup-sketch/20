extends Resource
class_name AIBrainProfile
## Профиль мозга врага (Q7.17, Фаза A): РУЧКИ СЛОЖНОСТИ — данные, не код
## (концепция ИИ заказчика §3; тот же паттерн, что CreatureProfile — единообразие).
## Уровни сложности (Новобранец/Солдат/Ветеран) = отдельные .tres с наборами
## чисел и родословной; тюнинг — Фаза B и ПОСЛЕ финальных анимаций (вердикт
## заказчика 1b от 2026-10-12: тайминги заморожены).
##
## Значения по умолчанию Фазы A подобраны так, чтобы поведение было ИДЕНТИЧНО
## legacy (преследование + случайные атаки, без блока врага): реакция 0,
## блок 0, паттерн 1 (= чистый рандом), токены 1 (дуэль 1v1).

@export_group("Ручки сложности (концепция §3)")
## Бюджет реакции врага, мс (концепция §3): задержка между ВИДИМЫМ стартом
## атаки игрока (attack_performed) и ответным решением (блок). 0 = мгновенно.
@export_range(0, 1000, 10) var reaction_ms := 0
## Отход после стана (B2, концепция §L2 «после стана — отход»): секунды
## принудительного RETREAT после окончания стана. 0.0 = legacy (без отхода).
@export_range(0.0, 5.0, 0.1) var post_stun_retreat_time := 0.0
## Вероятность блока врага (Фаза B: блок с бюджетом реакции; сейчас 0 = legacy).
@export_range(0.0, 1.0, 0.05) var block_chance := 0.0
## Вероятность угадать направление блока игрока (Фаза B).
@export_range(0.0, 1.0, 0.05) var block_dir_guess_chance := 0.0
## Множитель частоты атак (Фаза B; 1.0 = legacy).
@export_range(0.0, 2.0, 0.05) var aggression := 1.0
## Длина читаемой серии направлений (концепция §L2): 1 = чистый рандом (legacy);
## 2–3 = серии повторов с редкой сменой — игрок читает привычку врага.
@export_range(1, 4, 1) var pattern_length := 1
## Вероятность СМЕНЫ направления после исчерпания серии (концепция §L2 «серии
## 2-3 повторов с РЕДКОЙ сменой»): 1.0 = всегда новая (при length=1 — legacy-
## рандом); 0.35 = смена в 35% случаев, иначе то же направление ещё на серию.
## (0.0 = никогда не менять — край для тестов.)
@export_range(0.0, 1.0, 0.05) var pattern_switch_chance := 1.0
## Ритм дуэли (концепция §L4 в дуэльном режиме): пауза между циклами атаки, с —
## равномерный случайный интервал в [min, max] после получения исхода.
## 0.0/0.0 = legacy (бей сразу как ядро свободно). Числа Duelist-профиля —
## ПЕРВИЧНАЯ калибровка под feel-чек заказчика, не замерный факт.
@export_range(0.0, 5.0, 0.1) var attack_interval_min := 0.0
@export_range(0.0, 5.0, 0.1) var attack_interval_max := 0.0
## L4 задел под толпу (Doom-токены): сколько ударов разрешено на окно ритма.
@export_range(1, 8, 1) var tokens_per_window := 1
## Множитель длины замаха (телеграфа).
## СЛОВАРЬ РУЧКИ (фиксация по решению заказчика от 2026-10-12, п.5):
## на этапе плейсхолдерных анимаций телеграф физически масштабируется ТОЛЬКО
## целиком скоростью клипа (attack_animation_speed врага, экспорт тела);
## фазовое масштабирование (замах длиннее, свинг быстрый) возможно лишь с
## финальными анимациями. Известное нарушение контракта ≥0.5с (вердикт 1b):
## бюджет ПКМ RIGHT/UP = +0.133 с на 1.5 м (замер sim_block_timing Q7.15) —
## принято как известное до финальных анимаций. В Фазе A ручка — данные,
## потребитель появится при тюнинге (Фаза B+).
@export_range(0.5, 2.0, 0.05) var telegraph_scale := 1.0
