+vec3 veil_palette(vec3 dir) {
+	float h = clamp(dir.y, -1.0, 1.0);
+	vec3 c = mix(sk_horizon, sk_mid, smoothstep(0.02, 0.35, h));
+	c = mix(c, sk_zenith, smoothstep(0.30, 0.80, h));
